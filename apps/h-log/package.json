{
  "name": "h-log",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --no-warnings --test --experimental-strip-types lib/**/*.test.ts",
    "test:integration": "node -e \"if (!process.env.DATABASE_URL) { console.error('DATABASE_URL is required for integration tests'); process.exit(1) }\" && npm run test:migrations && npm run test:repository && npm run test:public-read-path && npm run test:worker && npm run test:dry-run && npm run test:brain && npm run test:resume && npm run test:admin:posts && npm run test:editorial && npm run test:drafts && npm run test:automation && npm run test:admin:operations && npm run test:jobs:retry && npm run test:observability:publishing",
    "test:jobs:retry": "node --no-warnings --experimental-strip-types --test lib/blog-job-retry.integration.test.ts",
    "test:jobs:retry:http": "node --test scripts/blog-job-retry.http.test.mjs",
    "test:observability:stack": "node --test scripts/observability-stack.test.mjs",
    "test:observability:probes": "node --no-warnings --experimental-strip-types --test scripts/observability-probes.test.mjs",
    "test:admin:operations": "node --no-warnings --experimental-strip-types --test lib/blog-admin-operations.integration.test.ts",
    "test:admin:operations:http": "node --test scripts/blog-admin-operations.http.test.mjs",
    "test:automation": "node --no-warnings --experimental-strip-types --test lib/blog-automation-policy.integration.test.ts",
    "test:drafts": "node --no-warnings --experimental-strip-types --test lib/blog-draft-requests.integration.test.ts",
    "test:drafts:http": "node --no-warnings --experimental-strip-types --test scripts/blog-draft.http.test.mjs",
    "draft:once": "node --no-warnings --experimental-strip-types scripts/blog-auto-publish.mjs --draft-once",
    "test:migrations": "node --test scripts/blog-migrations.integration.test.mjs",
    "test:repository": "node --no-warnings --test --experimental-strip-types lib/blog-postgres-repository.integration.test.ts",
    "test:public-read-path": "node --no-warnings --test --experimental-strip-types lib/blog-public-read-path.integration.test.ts",
    "test:worker": "node --no-warnings --test --experimental-strip-types lib/blog-persistent-worker.integration.test.ts",
    "test:dry-run": "node --no-warnings --test --experimental-strip-types lib/blog-local-dry-run.integration.test.ts",
    "test:brain": "node --no-warnings --test --experimental-strip-types lib/brain-postgres-repository.integration.test.ts",
    "test:brain:http": "node --test scripts/brain-capture.http.test.mjs",
    "test:admin:http": "node --test scripts/admin-owner.http.test.mjs",
    "test:editorial": "node --no-warnings --test --experimental-strip-types lib/blog-editorial-actions.integration.test.ts",
    "test:editorial:http": "node --no-warnings --test --experimental-strip-types scripts/blog-editorial.http.test.mjs",
    "test:admin:posts": "node --no-warnings --test --experimental-strip-types lib/blog-admin-review.integration.test.ts",
    "test:admin:posts:http": "node --test scripts/blog-admin-review.http.test.mjs",
    "test:resume": "node --no-warnings --test --experimental-strip-types lib/resume-pdf-repository.integration.test.ts",
    "test:resume:processor": "docker build --target resume-pdf-test -t hlog-resume-pdf-test . && docker run --rm --tmpfs /tmp/hlog-resume:size=32m,uid=1000,gid=1000,mode=0700,noexec,nosuid,nodev hlog-resume-pdf-test && docker run --rm --tmpfs /tmp/hlog-resume:size=32m,uid=1000,gid=1000,mode=0700,noexec,nosuid,nodev hlog-resume-pdf-test node --no-warnings --test --experimental-strip-types scripts/resume-pdf-storage.test.mjs && docker run --rm -e HLOG_RESUME_TEST_UNBOUNDED=1 hlog-resume-pdf-test node --no-warnings --test --experimental-strip-types scripts/resume-pdf-storage.test.mjs",
    "test:resume:http": "node --test scripts/resume-pdf.http.test.mjs",
    "test:resume:rehearsal": "node --no-warnings --experimental-strip-types scripts/resume-pdf.rehearsal.mjs",
    "resume:recovery-reset": "node --no-warnings --experimental-strip-types scripts/resume-pdf-recovery.mjs",
    "db:migrate": "node scripts/blog-migrations.mjs",
    "auth:preflight": "node --no-warnings --experimental-strip-types scripts/blog-hermes-auth-preflight.mjs",
    "auto-publish:cycle": "node --no-warnings --experimental-strip-types scripts/blog-auto-publish-cycle.mjs --once",
    "auto-publish:once": "node --no-warnings --experimental-strip-types scripts/blog-auto-publish.mjs --once",
    "dry-run:local": "node --no-warnings --experimental-strip-types scripts/blog-local-dry-run.mjs",
    "worker:once": "node --no-warnings --experimental-strip-types scripts/blog-worker.mjs --once",
    "typecheck": "tsc --noEmit",
    "test:observability:publishing": "node --no-warnings --experimental-strip-types --test lib/observability-publishing.integration.test.ts",
    "test:observability:state": "node --test scripts/observability-state.test.mjs",
    "test:observability:backup": "node --no-warnings --experimental-strip-types --test scripts/observability-backup.test.mjs",
    "observability:config": "node scripts/observability-config.mjs",
    "test:observability:alerts": "node --test scripts/observability-alerts.test.mjs",
    "test:observability:alerts:smoke": "node --test scripts/observability-alerts.smoke.mjs"
  },
  "dependencies": {
    "d3-force-3d": "3.0.6",
    "lucide-react": "^1.20.0",
    "marked": "18.0.14",
    "next": "16.4.3",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "25.9.3",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  }
}
