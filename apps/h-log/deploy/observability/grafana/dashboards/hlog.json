    {
      "id": 7,
      "type": "stat",
      "title": "CPU · 가용 메모리",
      "description": "60초 수집 · 현재 snapshot · Asia/Seoul 표시.  미수집/오류는 No data, 180초 초과는 stale이며 정상값으로 대체하지 않습니다.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hlog-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) and on() ((min(up{job=\"host\"}) == 1))",
          "legendFormat": "CPU 사용률 · 5분 rate",
          "datasource": {
            "type": "prometheus",
            "uid": "hlog-prometheus"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "(min(node_memory_MemAvailable_bytes) / min(node_memory_MemTotal_bytes)) and on() ((min(up{job=\"host\"}) == 1))",
          "legendFormat": "가용 메모리",
          "datasource": {
            "type": "prometheus",
            "uid": "hlog-prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
