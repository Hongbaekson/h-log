    },
    {
      "id": 2,
      "type": "stat",
      "title": "접속 · DB",
      "description": "60초 수집 · 현재 snapshot · Asia/Seoul 표시. 현재 probe 상태. 미수집/오류는 No data, 180초 초과는 stale이며 정상값으로 대체하지 않습니다.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hlog-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(probe_success) and on() ((min(up{job=\"http\"}) == 1))",
          "legendFormat": "{{target}}",
          "datasource": {
            "type": "prometheus",
            "uid": "hlog-prometheus"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "(pg_up) and on() ((min(up{job=\"database\"}) == 1))",
          "legendFormat": "DB",
          "datasource": {
            "type": "prometheus",
            "uid": "hlog-prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "미수집 / 오류",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "실패"
                },
                "1": {
                  "text": "정상"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
