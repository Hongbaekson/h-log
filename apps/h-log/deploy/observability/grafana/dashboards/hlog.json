{
  "uid": "hlog-operations",
  "title": "H-Log 운영",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Seoul",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "hlog",
    "private"
